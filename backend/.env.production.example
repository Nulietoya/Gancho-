# ETAPA 35 — modelo de variáveis de ambiente de PRODUÇÃO.
# Copie para backend/.env.production e preencha com valores reais.
# NUNCA commite o arquivo preenchido (backend/.env.production já
# deveria estar coberto pelo .gitignore existente, que ignora .env*
# — confira antes do primeiro deploy).

ENVIRONMENT=production
DEBUG=false

# Preenchido automaticamente pelo docker-compose.prod.yml a partir de
# POSTGRES_PASSWORD (ver abaixo) — não precisa repetir aqui também.
# DATABASE_URL=postgresql+psycopg2://gancho:SENHA@db:5432/gancho

# Senha do Postgres em produção — nunca a de desenvolvimento (gancho/gancho).
POSTGRES_PASSWORD=troque-por-uma-senha-forte-gerada-de-verdade

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# A aplicação RECUSA subir em produção com o valor de exemplo do
# repositório (guard adicionado na ETAPA 30-32) — isso é intencional.
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Domínio real do frontend publicado — usado no CORS e no corpo do
# e-mail de reset de senha (link de volta pro app).
CORS_ORIGINS=["https://SEU-DOMINIO-AQUI"]
FRONTEND_URL=https://SEU-DOMINIO-AQUI

# E-mail real — sem nenhuma das duas opções abaixo, e-mail de reset
# de senha continua caindo no backend de log (app/core/email.py) em
# vez de ser entregue de verdade, mesmo em produção.
#
# Opção 1 (recomendada) — Resend, API via HTTPS: funciona em qualquer
# plano de hospedagem, inclusive nos que bloqueiam SMTP de saída
# (ex.: Railway nos planos Free/Trial/Hobby). Criar conta grátis em
# resend.com e colar a API key.
RESEND_API_KEY=
# Sem RESEND_FROM_EMAIL, usa o domínio de teste do Resend
# (onboarding@resend.dev) — só entrega pro e-mail da própria conta
# Resend. Pra entregar pra qualquer destinatário, verificar um
# domínio em resend.com/domains e colocar aqui um remetente desse
# domínio (ex.: "Gancho <no-reply@seu-dominio.com>").
RESEND_FROM_EMAIL=

# Opção 2 — SMTP padrão: só funciona se a hospedagem liberar portas
# SMTP (25/465/587) de saída no plano usado. Qualquer provedor SMTP
# padrão serve.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
